# Copy to backend/.env for local development.

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Render PostgreSQL connection string. Leave unset locally to use SQLite.
DATABASE_URL=

# Comma-separated origins allowed to call the API (your Vercel domain in prod).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Optional. Leave blank to use the key-free Nominatim + OSRM stack.
# With a key, routing switches to the OpenRouteService driving-hgv profile.
ORS_API_KEY=

GEOCODER_USER_AGENT=eld-trip-planner/1.0 (your-email@example.com)
ROUTING_TIMEOUT=20
API_RATE_LIMIT=60/min
